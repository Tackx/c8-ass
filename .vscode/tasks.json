{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build ass",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++26",
                "-g",
                "-Wall",
                "-Wextra",
                "./ass.cpp",
                "-o",
                "ass",
                "-lstdc++exp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}